# Where waitlist and partner-interest records are saved.
#   supabase  production: needs the two SUPABASE_ values below
#   file      local development only: writes JSON to .data/ (refused on Vercel)
#   (unset)   forms show "Waitlist signup isn't available yet."
SIGNUP_STORE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-side only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# PREVIEW (default) or LIVE_CLAUDE. LIVE_CLAUDE is not implemented in this build.
NEXT_PUBLIC_DEMO_MODE=PREVIEW
