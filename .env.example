# ---- Where signups are saved ----
#   supabase  production (needs the two SUPABASE_ values)
#   file      local development only: writes JSON to .data/ (refused on Vercel)
#   (unset)   the form says it's a demo and saves nothing
SIGNUP_STORE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-side only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin page at /admin ----
# 10+ characters. Without it, /admin stays locked.
ADMIN_PASSWORD=

# ---- Signup confirmation (optional, off by default) ----
# The launch email is sent from the admin CSV. Set to true to also confirm at signup.
SEND_SIGNUP_EMAIL=false
RESEND_API_KEY=
EMAIL_FROM="Off Menu <hello@yourdomain.com>"

# Used to build invite links in emails
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
